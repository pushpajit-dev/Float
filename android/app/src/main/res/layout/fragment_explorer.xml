<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/float_bg">

    <!-- Top Root & Search Header -->
    <LinearLayout
        android:id="@+id/headerExplorer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/float_surface"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title & Storage Roots Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sd_card"
                app:tint="@color/float_emerald" />

            <TextView
                android:id="@+id/tvCurrentRootTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Internal Storage"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchRoot"
                style="@style/Widget.Float.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingHorizontal="10dp"
                android:text="Switch Drive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted" />

            <EditText
                android:id="@+id/etSearchFiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Breadcrumbs bar -->
        <LinearLayout
            android:id="@+id/layoutBreadcrumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnNavigateUp"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_forward"
                android:rotation="180"
                app:tint="@color/float_emerald" />

            <TextView
                android:id="@+id/tvBreadcrumbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="start"
                android:singleLine="true"
                android:text="/storage/emulated/0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dividerExplorer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/float_divider"
        app:layout_constraintTop_toBottomOf="@id/headerExplorer" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyExplorer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerExplorer">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Empty directory or no search results"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- File & Folder List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExplorerItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerExplorer" />

    <!-- Upload / Add Action Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabUploadToDrive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Upload / Write"
        android:textColor="@color/text_on_emerald"
        app:icon="@drawable/ic_send"
        app:iconTint="@color/text_on_emerald"
        app:backgroundTint="@color/float_emerald"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
