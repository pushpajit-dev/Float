<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/float_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#26EF4444"
            android:padding="8dp"
            android:src="@drawable/ic_bug_report"
            app:tint="@color/float_fan_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Float Crashed"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="An error was captured. You can report it below."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Device Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/float_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/float_card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAGNOSTIC DETAILS"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="Phone: Xiaomi 2201117TY" />

            <TextView
                android:id="@+id/tvAndroidVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="Android Version: Android 13 (SDK 33)" />

            <TextView
                android:id="@+id/tvKernelVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="Kernel: 5.10.149-android12-9-00001" />

            <TextView
                android:id="@+id/tvCrashReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/float_fan_red"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Reason: java.lang.InterruptedException" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Stack Trace Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CRASH LOG"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyLog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Copy Log"
                android:textColor="@color/float_emerald"
                android:textSize="12sp"
                app:icon="@drawable/ic_copy"
                app:iconSize="14dp"
                app:iconTint="@color/float_emerald" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/float_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/float_card_border"
            app:strokeWidth="1dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvStackTrace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#CBD5E1"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    tools:text="java.lang.InterruptedException\n    at java.lang.Thread.sleep..." />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestartApp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Restart"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/float_card_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportCrash"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:backgroundTint="@color/float_emerald"
            android:text="Report Crash"
            android:textColor="@color/text_on_emerald"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/text_on_emerald" />
    </LinearLayout>

</LinearLayout>
