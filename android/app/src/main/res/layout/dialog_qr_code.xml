<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/float_surface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Title and Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scan to Connect"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDialogQrClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scan from PC or phone camera to connect instantly"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Crisp White QR Box (Clean, high contrast, NOT green) -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_small_qr_box"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivDialogQrImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="QR Code"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- URL Pill (fits in one line) -->
        <TextView
            android:id="@+id/tvDialogQrUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:singleLine="true"
            android:text="https://xxxx.a.pinggy.link"
            android:textColor="@color/float_emerald_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Actions: Copy and Share side-by-side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogQrCopy"
                style="@style/Widget.Float.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Copy Link"
                android:textSize="13sp"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogQrShare"
                style="@style/Widget.Float.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Share Link"
                android:textSize="13sp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconSize="16dp" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>
