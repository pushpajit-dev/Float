<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Float.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill"
            android:padding="8dp"
            android:src="@drawable/ic_file"
            app:tint="@color/float_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="document.pdf"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.2 MB"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFileBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="One-Time"
                    android:textColor="@color/float_cyan"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Copy Link Button -->
        <ImageButton
            android:id="@+id/btnCopyFileLink"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Copy Link"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_copy"
            app:tint="@color/text_secondary" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnDeleteSharedFile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="@color/float_fan_red" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
