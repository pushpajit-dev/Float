<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ZXing Camera View -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="true" />

    <!-- Top Bar with Back button and "Scan to Connect" -->
    <LinearLayout
        android:id="@+id/topBarScanner"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnScannerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#66000000"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvScannerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Scan to Connect"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Centered Square Box Viewfinder Frame -->
    <FrameLayout
        android:id="@+id/viewfinderSquare"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_scanner_box"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Bottom Click Button -->
    <ImageButton
        android:id="@+id/btnScannerAction"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#B3111827"
        android:contentDescription="Toggle Flashlight"
        android:padding="14dp"
        android:src="@drawable/ic_flashlight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/float_emerald" />

</androidx.constraintlayout.widget.ConstraintLayout>
