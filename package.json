{
  "name": "float",
  "version": "1.0.0",
  "description": "Float — self-hosted file transfer for your local network. Drop any file, any size; anyone on the LAN downloads it from a browser via link or QR. No cloud, no accounts, no size limits, LAN-only by design. Developed by NoishiXzen. Powered by MeghXL system & core.",
  "type": "commonjs",
  "main": "server.js",
  "bin": {
    "float": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "app:desktop": "npm --prefix desktop run build",
    "autostart:install": "bash scripts/install-autostart.sh",
    "autostart:uninstall": "bash scripts/uninstall-autostart.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "file-transfer",
    "file-sharing",
    "lan",
    "local-network",
    "intranet",
    "office",
    "enterprise",
    "self-hosted",
    "airdrop",
    "nearby-share",
    "wifi-transfer",
    "qr",
    "mdns",
    "p2p",
    "cross-platform",
    "drag-and-drop",
    "dashboard",
    "float",
    "meghxl"
  ],
  "license": "Apache-2.0",
  "author": "NoishiXzen <noishixzen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushpajit-dev.git"
  },
  "bugs": {
    "url": "https://github.com/pushpajit-dev/issues"
  },
  "homepage": "https://aivorygen.netlify.app",
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "multer": "^2.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
